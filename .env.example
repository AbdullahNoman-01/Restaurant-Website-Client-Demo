# ==============================================================================
# The Chesterfield Kitchen & Bar - Environment Variables Template
# Copy this file to .env and fill in your test / sandbox credentials.
# NEVER commit your production secrets to source control!
# ==============================================================================

# Django Core Settings
SECRET_KEY=django-insecure-the-chesterfield-luxury-kitchen-bar-key-replace-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Base Site URL (Used for Stripe & PayPal redirect URLs & webhooks)
SITE_URL=http://127.0.0.1:8000

# Restaurant Currency Code
RESTAURANT_CURRENCY=USD

# ------------------------------------------------------------------------------
# A. STRIPE TEST MODE CONFIGURATION
# Obtain test credentials from: https://dashboard.stripe.com/test/apikeys
# Webhook secret from: https://dashboard.stripe.com/test/webhooks
# ------------------------------------------------------------------------------
STRIPE_PUBLISHABLE_KEY=pk_test_51...your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_51...your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_...your_stripe_webhook_secret

# ------------------------------------------------------------------------------
# B. PAYPAL SANDBOX CONFIGURATION
# Obtain sandbox credentials from: https://developer.paypal.com/dashboard/applications/sandbox
# Mode can be 'sandbox' or 'live'
# ------------------------------------------------------------------------------
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_MODE=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
